// Schema de Prisma para QA Forge. Dev usa SQLite; prod usa PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres en dev y prod. Para dev local levantar postgres con:
  //   docker compose up redis postgres -d
  // (postgres está en el profile "full"; ver docker-compose.yml). O usar
  // cualquier postgres local. DATABASE_URL se toma del .env.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String? // nombre opcional para mostrar
  role         String   @default("user") // user | admin (reservado para futuro)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys UserApiKey[]
  scans   Scan[]
  schedules ScheduledScan[]
  jiraConfig JiraConfig?
  jiraIssues JiraIssueLink[]
}

// FASE 8.10: integración con Jira. Una config por usuario (Jira Cloud:
// baseUrl + email + API token). El token se cifra AES-256-GCM igual que las
// API keys de IA. Permite crear bugs en Jira desde un Result con FAIL/WARNING.
model JiraConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  baseUrl           String // https://<org>.atlassian.net (sin trailing slash)
  email             String // email de la cuenta Atlassian (auth Basic)
  encryptedToken    String // API token cifrado — descifrado en runtime con SECRET_ENCRYPTION_KEY
  hint              String // primeros 4 + últimos 4 chars del token, para identificarlo en UI
  defaultProjectKey String? // proyecto preseleccionado al crear bugs
  defaultIssueType  String   @default("Bug")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Enlace entre un Result (FAIL/WARNING) y el issue de Jira creado a partir de
// él. Evita bugs duplicados y permite mostrar "bug ya creado: QA-123" en la UI.
model JiraIssueLink {
  id        String   @id @default(cuid())
  userId    String
  scanId    String
  resultId  String
  issueKey  String // ej. QA-123
  issueUrl  String // deep link al issue en Jira
  summary   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([resultId])
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String // anthropic | gemini | openai | openrouter | ollama
  label        String? // alias opcional ("Mi key de trabajo")
  encryptedKey String // AES-GCM(base64) — descifrado en runtime con SECRET_ENCRYPTION_KEY
  hint         String // primeros 4 + últimos 4 chars de la key original, para identificarla en UI
  isDefault    Boolean  @default(false) // marcada como key default para ese provider
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, provider])
}

// FASE 8.6: scans programados via cron. El cron-master en backend hace tick
// cada 60s y dispara los que tocan. Notifier opcional via webhook (Slack/Discord)
// o email SMTP cuando el scan termina.
model ScheduledScan {
  id            String   @id @default(cuid())
  userId        String
  name          String // alias humano para identificar el schedule
  cron          String // expresión cron (5 o 6 campos: '0 9 * * *' = 9am diario)
  timezone      String   @default("UTC")
  enabled       Boolean  @default(true)

  // Configuración del scan que se va a crear (mismo shape que POST /api/scan)
  url           String
  deviceProfile String   @default("desktop")
  browserEngine String   @default("chromium")
  mode          String   @default("single")
  maxPages      Int      @default(1)
  loginConfig   Json? // mismo formato cifrado que Scan.loginConfig

  // Notificaciones
  notifyWebhook String? // Slack/Discord webhook URL
  notifyEmail   String? // destinatario; requiere SMTP_* en .env
  notifyOn      String   @default("always") // always | onFailOnly | onWarningOrFail

  // Estado
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastScanId    String? // último Scan creado por este schedule

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, nextRunAt])
}

model Scan {
  id          String    @id @default(cuid())
  url         String
  status      String    @default("pending") // pending | running | completed | failed | cancelled
  stage       String? // etapa actual (SCAN_STAGE) — se actualiza durante el run
  errorMessage String?
  notes       String? // notas libres de QA (Markdown), editables desde la UI
  cancelRequestedAt DateTime? // si está seteado, el worker aborta el pipeline
  deviceProfile String  @default("desktop") // ver shared/constants.js DEVICE_PROFILES
  browserEngine String  @default("chromium") // FASE 8.8: chromium | firefox | webkit
  loginConfig Json? // FASE 7.4: config opcional de login pre-flight (selectors + creds cifradas)
  mode        String  @default("single") // single | crawl (FASE 7.5)
  maxPages    Int     @default(1) // tope de URLs cuando mode=crawl
  parentScanId String? // si pertenece a un crawl, apunta al scan padre
  scheduledScanId String? // si fue disparado por un cron schedule, FK al ScheduledScan
  userId      String? // dueño del scan (nullable para retro-compatibilidad)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  Scan?    @relation("ScanChildren", fields: [parentScanId], references: [id], onDelete: Cascade)
  children Scan[]  @relation("ScanChildren")
  results Result[]
  scripts Script[]
  screenshots Screenshot[]
  jiraIssues JiraIssueLink[]
  manualRuns ManualCaseRun[]

  @@index([url])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([parentScanId])
  @@index([scheduledScanId])
}

model Result {
  id        String   @id @default(cuid())
  scanId    String
  category  String // functional | security | performance | accessibility | seo
  testName  String
  status    String // pass | fail | warning | info
  score     Float?
  details   String // JSON serializado (SQLite no soporta Json nativo en todos los providers)
  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([category])
}

// FASE 8.9: screenshots persistidos (baseline, current, diff) para visual
// regression. Una tupla (url, deviceProfile, browserEngine, kind=baseline)
// se considera la referencia para futuros scans de la misma combinación.
model Screenshot {
  id            String   @id @default(cuid())
  scanId        String
  url           String // URL exacta scaneada (para crawls, la URL del child)
  deviceProfile String
  browserEngine String
  kind          String // baseline | current | diff
  width         Int
  height        Int
  dataB64       String // PNG base64 — no usamos bytes para que el SDK de Prisma + JSON sea fácil
  createdAt     DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([url, deviceProfile, browserEngine, kind])
  @@index([scanId])
}

model Script {
  id        String   @id @default(cuid())
  scanId    String
  framework String // playwright | cypress | selenium
  language  String // typescript | javascript | python
  content   String
  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

// FASE 9: runner de casos de prueba manuales. Trackea el estado de ejecución
// de cada caso para un scan. Cubre 3 fuentes (MANUAL_CASE_SOURCE):
//   - `generic`: catálogo fijo GENERIC_TEST_CASES en shared/constants.js
//   - `ai`:      casos generados por LLM (viven en Script framework="manual")
//   - `custom`:  casos creados a mano por el usuario — su definición completa
//                se guarda en `payload` (los otros 2 la toman de su origen).
// caseKey es estable dentro del scan: para generic = item.key, para ai = tc.id,
// para custom = "custom:<cuid>". El @@unique permite upsert idempotente.
model ManualCaseRun {
  id         String    @id @default(cuid())
  scanId     String
  source     String // generic | ai | custom
  caseKey    String // identificador estable del caso dentro del scan
  status     String    @default("pending") // pending | pass | fail | blocked | skipped
  notes      String? // notas de ejecución del tester (qué falló, evidencia)
  payload    Json? // definición del caso — solo para source=custom
  executedAt DateTime? // última vez que se marcó un estado terminal (no-pending)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, caseKey])
  @@index([scanId])
}
