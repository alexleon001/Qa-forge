# Variables de entorno del backend de QA Forge.

PORT=3001
# Lista de orígenes permitidos por CORS, separados por coma. Acepta el dominio
# de Vercel (prod + preview *.vercel.app) además del dev local.
FRONTEND_URL=http://localhost:5173

# Prisma — Postgres en dev y prod. Para dev local: `docker compose up postgres -d`
# levanta el postgres del compose (user/pass/db = qaforge).
DATABASE_URL=postgresql://qaforge:qaforge@localhost:5432/qaforge

# Redis para BullMQ queue. En Railway usar la REDIS_URL del addon.
REDIS_URL=redis://localhost:6379

# ─── Auth (FASE 7) ─────────────────────────────────────────────────────────
# Secret para firmar JWTs de sesión. >=16 chars. Generar con: openssl rand -base64 48
JWT_SECRET=cambiame-en-prod-con-openssl-rand-base64-48

# Secret para cifrar las API keys de IA guardadas por usuario (AES-256-GCM).
# >=16 chars. SI SE PIERDE, las keys cifradas son irrecuperables.
SECRET_ENCRYPTION_KEY=cambiame-en-prod-con-openssl-rand-base64-48

# Si =false, /api/auth/register devuelve 403. Útil después de crear los users
# del equipo, para evitar registros públicos.
ALLOW_REGISTRATION=true

# ─── Script Generator (FASE 3 + FASE 5) ──────────────────────────────────────
# Provider de IA por defecto. Opciones: gemini | anthropic | openai | openrouter | ollama | auto
# Con `auto` el backend recorre los providers en orden y usa el primero configurado.
AI_PROVIDER=gemini

# Modelo por provider (opcional — cada provider trae uno default razonable).
# AI_MODEL_GEMINI=gemini-2.0-flash
# AI_MODEL_OPENAI=gpt-4o-mini
# AI_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct
# AI_MODEL_OLLAMA=qwen2.5-coder:7b

# Anthropic (paga). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini (free tier generoso). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (paga). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (pay-per-use, acceso a 100+ modelos). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Opcional, recomendado por OpenRouter para identificar la app:
# OPENROUTER_REFERER=http://localhost:5173

# Ollama (local, gratis). Asumido en http://localhost:11434 si está corriendo.
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Otros ──────────────────────────────────────────────────────────────────
# Google PageSpeed Insights — opcional. Sin key aplica rate limit más estricto.
PAGESPEED_API_KEY=
